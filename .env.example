# ==========================================
# T1GER Environment Configuration
# ==========================================

# Gemini AI Integration (Lesson generation & proof verification)
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouter AI (Profesor T1GER - NVIDIA Nemotron 3 Ultra 550B MoE)
VITE_OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
VITE_ENABLE_CLIENT_AI="true"

# OneSignal Push Notifications (Android 13+ FCM Backed)
VITE_ONESIGNAL_APP_ID="YOUR_ONESIGNAL_APP_ID"

# Firebase Cloud Messaging & Firestore
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="t1ger-69d6a.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="t1ger-69d6a"
VITE_FIREBASE_STORAGE_BUCKET="t1ger-69d6a.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="109876543210"
VITE_FIREBASE_APP_ID="1:109876543210:web:abcdef1234567890"
VITE_FIRESTORE_DATABASE_ID="(default)"

# App Runtime Settings
VITE_APP_MODE="production"
VITE_AUTH_DISABLED="false"
VITE_USE_FIREBASE_EMULATOR="false"
