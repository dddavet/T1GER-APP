{
  "name": "tiger-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "dev:prototype": "vite --mode prototype --port=3000 --host=127.0.0.1",
    "generate:mascot": "node scripts/generate-t1ger-mascot.mjs",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "firebase:auth-emulator": "firebase emulators:start --only auth --project t1ger-69d6a --import=./.firebase-emulator-data --export-on-exit=./.firebase-emulator-data",
    "firebase:seed-auth": "tsx src/scripts/seedAuthEmulator.ts",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "android:sync": "npm run build && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "android:bundle": "npm run android:build && cd android && gradlew bundleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.11.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "onesignal-cordova-plugin": "^5.5.2",
    "react": "^19.0.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-onesignal": "^3.5.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "ts-fsrs": "^5.4.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.18.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
