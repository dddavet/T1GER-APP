{
  "name": "tiger-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "qs": "6.16.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-native-dependencies.mjs",
    "dev": "vite --port=3000 --host=127.0.0.1 --strictPort",
    "dev:web": "vite --port=3000 --host=127.0.0.1 --strictPort --open \"/?previewApp=1&view=learn\"",
    "dev:phone": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "dev:android": "node scripts/android-live.mjs",
    "dev:android:emulator": "node scripts/android-live.mjs --emulator --avd=T1GER_API_36",
    "dev:android:wifi": "node scripts/android-live.mjs --wifi",
    "dev:prototype": "vite --mode prototype --port=3000 --host=127.0.0.1",
    "generate:mascot": "node scripts/generate-t1ger-mascot.mjs",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:opportunity": "tsx scripts/verify-opportunity-cost.ts",
    "test:curriculum": "tsx scripts/verify-interactive-curriculum.ts",
    "test:social": "tsx scripts/verify-social-engine.ts",
    "test:core": "tsx scripts/verify-core-progression.ts",
    "test:shell": "node scripts/verify-app-shell.mjs",
    "test:rules": "npm --prefix functions run build && node scripts/test-firebase.mjs",
    "test:all": "npm run lint && npm run test:core && npm run test:curriculum && npm run test:social && npm run test:opportunity && npm run test:rules",
    "release:check": "node scripts/release-preflight.mjs",
    "firebase:auth-emulator": "firebase emulators:start --only auth --project t1ger-69d6a --import=./.firebase-emulator-data --export-on-exit=./.firebase-emulator-data",
    "firebase:seed-auth": "tsx src/scripts/seedAuthEmulator.ts",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "android:sync": "npm run build && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "android:bundle": "node scripts/build-android.mjs --release",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@revenuecat/purchases-capacitor": "^13.4.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.11.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "onesignal-cordova-plugin": "^5.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-onesignal": "^3.5.6",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.18.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
